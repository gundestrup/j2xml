// markdownlint-cli2 configuration — used by CLI and vscode-markdownlint.
{
  "config": {
    "MD013": {
      "line_length": 120,
      "tables": false,
      "code_blocks": false,
      "headings": false
    },
    "MD024": { "siblings_only": true },
    "MD012": { "maximum": 3 },
    "MD041": false
  },
  "gitignore": true,
  "globs": [
    "AGENTS.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "DEVIN.md",
    "DOCUMENTATION.md",
    "README.md",
    "README.devel*.md",
    "RELEASE.md",
    "SECURITY.md",
    "STYLING.md",
    "TESTING.md",
    "WINDSURF.md",
    ".devin/*.md",
    ".github/**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "vendor/**",
    "coverage/**",
    "tmp/**",
    "build/**"
  ]
}
