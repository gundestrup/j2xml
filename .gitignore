administrator/language/it-IT
language/it-IT

# sl-SI
administrator/language/sl-SI
language/sl-SI

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk
*.url

# Joomla
CHANGELOG

# =========================
# Composer dev dependencies
# =========================
vendor/

# =========================
# PHPUnit coverage output
# =========================
coverage.xml
coverage-integration.xml
.phpunit.result.cache

# =========================
# Node.js / npm build tooling
# =========================
# Build tooling for vendored JS bundles (e.g. pako, base64)
# Only the built output is committed, not the tooling
build/pako/node_modules/
build/base64/node_modules/
build/coverage-raw/
node_modules/

# Playwright UI test artifacts
tests/ui/test-results/
tests/ui/playwright-report/

# Built extension packages — regenerated by scripts/build-package.sh
# on every test run / release; attach to GitHub releases instead of committing
build/*.zip

