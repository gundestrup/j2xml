<?xml version="1.0" encoding="UTF-8"?>
<!--
  CLI import fixture: a single category that exercises the CLI importer
  path (cli/j2xml.php) without triggering the Joomla Workflow component,
  which requires a CMSApplication that the CliApplication does not extend
  on Joomla 5/6.  Content import via CLI is a known limitation tracked
  separately.
-->
<j2xml version="21.12.0">
  <category>
    <id>5001</id>
    <title>J2XML CLI Import Category</title>
    <alias>j2xml-cli-import-category</alias>
    <description><![CDATA[<p>Category created by the CLI importer test.</p>]]></description>
    <published>1</published>
    <access>1</access>
    <parent_id>1</parent_id>
    <extension>com_content</extension>
    <language>*</language>
  </category>
</j2xml>
