ARG JOOMLA_SOURCE_IMAGE=joomla:6.2.0-php8.4-apache
FROM ${JOOMLA_SOURCE_IMAGE} AS joomla-source

# Pinned to the multi-platform manifest-list digest (linux/amd64 + linux/arm64),
# so the same pin resolves natively on Apple Silicon and AMD64/CI hosts.
# To update: docker buildx imagetools inspect php:8.5-apache
FROM php:8.5-apache@sha256:08af36df144462d84c7f16190557eec06cb9f656882685610b712a15eec54d46

RUN apt-get update \
    && apt-get install -y --no-install-recommends libbz2-dev libfreetype-dev libgmp-dev libicu-dev libjpeg62-turbo-dev libpng-dev libpq-dev libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath bz2 exif gd gmp intl mysqli pdo_mysql pdo_pgsql pgsql zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=joomla-source /entrypoint.sh /entrypoint.sh
COPY --from=joomla-source /makedb.php /makedb.php
COPY --from=joomla-source /usr/src/joomla /usr/src/joomla

ENTRYPOINT ["/entrypoint.sh"]
CMD ["apache2-foreground"]
