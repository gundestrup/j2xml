	<creationDate>__DEPLOY_DATE__</creationDate>
	<authorEmail>info (at) eshiol (dot) it</authorEmail>
	<authorUrl>www.eshiol.it</authorUrl>
	<copyright><![CDATA[(C) 2010 - 2026 Helios Ciancio. All Rights Reserved.]]></copyright>
	<license>http://www.gnu.org/licenses/gpl-3.0.html GNU/GPL v3</license>
	<version>__DEPLOY_VERSION__</version>
	<description>PLG_WEBSERVICES_J2XML_XML_DESCRIPTION</description>
	<files>
		<filename plugin="j2xml">j2xml.php</filename>
		<filename>index.html</filename>
	</files>
	<languages>
		<language tag="en-GB">en-GB/en-GB.plg_webservices_j2xml.ini</language>
		<language tag="en-GB">en-GB/en-GB.plg_webservices_j2xml.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="enabled"
					type="radio"
					class="btn-group btn-group-yesno"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="PLG_WEBSERVICES_J2XML_ENABLED_LABEL"
					description="PLG_WEBSERVICES_J2XML_ENABLED_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
